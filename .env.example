# =============================================================================
# Secret ứng dụng — nguồn duy nhất là Infisical self-host (secrets.vinhpham.com.vn).
# KHÔNG khai trực tiếp trong Coolify. CLI Infisical sẽ inject các biến này cả ở
# bước build (`infisical run -- pnpm run build`) lẫn runtime (`infisical run -- node server.js`).
# Liệt kê ở đây chỉ để biết cần khai gì TRONG project Infisical.
# =============================================================================
NEXT_PUBLIC_SITE_URL=
AIRTABLE_API_KEY=
JOBS_TABLE=
LOCATIONS_TABLE=
JOB_CATEGORIES_TABLE=
JOB_TYPES_TABLE=
PRODUCT_GROUPS_TABLE=
BASE_ID=
SUBSCRIBERS_TABLE=

# =============================================================================
# Biến hạ tầng — KHAI TRONG COOLIFY, KHÔNG để trong Infisical.
# Cần cả ở "Build Variable" (vì build kéo secret từ Infisical) lẫn runtime env.
# =============================================================================
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=prod
# Service token của Cloudflare Access để CLI đi qua lớp Access (thay cho OTP của con người).
# Tạo ở Cloudflare Zero Trust > Access > Service Auth > Service Tokens.
# Định dạng (2 header cách nhau bởi dấu cách):
#   CF-Access-Client-Id=<client-id> CF-Access-Client-Secret=<client-secret>
INFISICAL_CUSTOM_HEADERS=
